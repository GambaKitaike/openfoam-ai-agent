# ────────────────────────────────────────────────
# OpenFOAM AI Agent - 環境設定テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ────────────────────────────────────────────────

# LLM プロバイダー選択: openai または anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o

# Anthropic Claude (LLM_PROVIDER=anthropic の場合)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-opus-4-5

# OpenFOAM インストールパス（デフォルトは v2512）
# OPENFOAM_PATH=/usr/lib/openfoam/openfoam2512
