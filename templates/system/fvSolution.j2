FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
{% set has_wall = case_type in ["channel_2d", "channel_3d", "external_snappy", "snappy_external", "snappy_2d", "heat_transfer"] %}
{% set is_snappy = case_type in ["external_snappy", "snappy_external", "snappy_2d"] %}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

{% if not steady_state %}
    // pimpleFoam: 最終修正ステップはより厳密に
    pFinal
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0;
    }
{% endif %}

    "(U|k|omega|epsilon|nuTilda)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          0.1;
    }

{% if not steady_state %}
    "(U|k|omega|epsilon|nuTilda)Final"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          0;
    }
{% endif %}
}

{% if steady_state %}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
{% if has_wall %}
    consistent      yes;
{% else %}
    // 壁なし外部流れ: consistent yes は不安定のため無効
    pRefCell        0;
    pRefValue       0;
{% endif %}

    residualControl
    {
        p               1e-2;
        U               1e-3;
        "(k|omega|epsilon|nuTilda)" 1e-3;
    }
}

relaxationFactors
{
{% if has_wall %}
    // 壁あり: SIMPLEC (consistent yes) なので p fields 緩和不要
    equations
    {
        U               0.9;
        ".*"            0.9;
    }
{% else %}
    // 壁なし: 標準 SIMPLE 保守設定
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        k               0.7;
        omega           0.7;
        epsilon         0.7;
        nuTilda         0.7;
    }
{% endif %}
}

{% else %}
PIMPLE
{
{% if is_snappy %}
    // snappyHexMesh（極細セルあり）: 多めのCorrectorで安定化
    nOuterCorrectors    5;
    nCorrectors         3;
    nNonOrthogonalCorrectors 2;
{% else %}
    nOuterCorrectors    3;
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;
{% endif %}
    // Courant 爆発時の安全弁: 残差が発散したら時間刻みを半減
    maxCo               0.9;
{% if not has_wall %}
    pRefCell            0;
    pRefValue           0;
{% endif %}
}

relaxationFactors
{
    equations
    {
{% if is_snappy %}
        // snappy: 保守的な緩和係数で初期過渡を安定化
        U               0.7;
        k               0.7;
        omega           0.7;
{% else %}
        U               0.9;
        k               0.9;
        omega           0.9;
{% endif %}
    }
}
{% endif %}

