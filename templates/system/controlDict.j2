FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// 解析: {{ description }}

application     {{ solver }};

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         {{ end_time }};

deltaT          {{ delta_t }};

{% if steady_state %}
writeControl    timeStep;
writeInterval   1;
{% elif is_karman_ogrid %}
// カルマン渦: 物理時間ベースで周期ごとに十分な枚数を保存
writeControl    runTime;
writeInterval   {{ write_interval }};
{% elif case_type == "cylinder_2d_ogrid" or solver == "icoFoam" %}
// 固定 dt: adjustableRunTime の書き出しタイミング調整による dt 急変を回避
writeControl    timeStep;
writeInterval   {{ [1, (write_interval / delta_t) | int] | max }};
{% else %}
writeControl    adjustableRunTime;
writeInterval   {{ write_interval }};
{% endif %}
purgeWrite      {{ purge_write }};

{% if not steady_state and case_type != "cylinder_2d_ogrid" and solver != "icoFoam" %}
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       {{ "%.6g" | format(delta_t * 100) }};
{% endif %}

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
