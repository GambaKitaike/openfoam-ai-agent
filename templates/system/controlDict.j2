FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// 解析: {{ description }}

application     {{ solver }};

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         {{ end_time }};

deltaT          {{ delta_t }};

writeControl    {% if steady_state %}timeStep{% else %}adjustableRunTime{% endif %};
writeInterval   {{ write_interval }};
purgeWrite      {% if steady_state %}0{% else %}5{% endif %};  // 非定常: 直近5タイムステップのみ保持

{% if not steady_state %}
adjustTimeStep  yes;
maxCo           0.5;   // 保守的設定: snappyHexMesh の極細セル対策
maxAlphaCo      0.5;
// maxDeltaT: 初期 deltaT の 100 倍まで。急激な増大を防ぐ
maxDeltaT       {{ "%.6g" | format(delta_t * 100) }};
{% endif %}

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
