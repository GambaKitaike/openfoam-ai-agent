FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// 内部流れ用 直方体（ダクト・パイプ断面が矩形の場合）
// 流れ方向: +x  鉛直方向: +y  幅方向: +z

convertToMeters 1.0;

// 計算領域: x=[0, {{ lx }}], y=[0, {{ ly }}], z=[0, {{ lz }}]
// セル数: {{ nx }} x {{ ny }} x {{ nz }}
// 壁面近傍グレーディング: {{ grading_y }} (1=等間隔, >1=壁面に向かって細かく)

vertices
(
    ( 0        0        0       )   // 0
    ( {{ lx }} 0        0       )   // 1
    ( {{ lx }} {{ ly }} 0       )   // 2
    ( 0        {{ ly }} 0       )   // 3
    ( 0        0        {{ lz }} )  // 4
    ( {{ lx }} 0        {{ lz }} )  // 5
    ( {{ lx }} {{ ly }} {{ lz }} )  // 6
    ( 0        {{ ly }} {{ lz }} )  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7)
    ({{ nx }} {{ ny }} {{ nz }})
    simpleGrading
    (
        1             // x方向: 等間隔
        (             // y方向: 両壁面に向かって細かくなるグレーディング
            ( 0.3  0.5  {{ grading_y }} )
            ( 0.4  0.5  1              )
            ( 0.3  0.5  {{ grading_y_inv }} )
        )
        1             // z方向: 等間隔（2D的な扱い or 正方形断面なら対称）
    )
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    wall
    {
        type wall;
        faces
        (
            (0 1 5 4)   // bottom
            (3 7 6 2)   // top
            (0 3 2 1)   // back
            (4 5 6 7)   // front
        );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
