/*--------------------------------*- C++ -*----------------------------------*\
  カルマン渦: 円柱後流に横方向速度を与えて対称解からの分岐を促す
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volVectorFieldValue U ({{ inlet_velocity }} 0 0)
);

regions
(
    // 円柱直下流: 上下非対称な横速度を付与
    boxToCell
    {
        box ({{ wake_x0 }} -{{ wake_y }} 0) ({{ wake_x1 }} 0 {{ depth }});
        fieldValues
        (
            volVectorFieldValue U ({{ inlet_velocity }} {{ perturb_vy }} 0)
        );
    }
    boxToCell
    {
        box ({{ wake_x0 }} 0 0) ({{ wake_x1 }} {{ wake_y }} {{ depth }});
        fieldValues
        (
            volVectorFieldValue U ({{ inlet_velocity }} {{ -perturb_vy }} 0)
        );
    }
);

// ************************************************************************* //
